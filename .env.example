# ==========================================
# Radar-e-Jang - Vercel & PostgreSQL Environment Variables
# ==========================================

# 1. PostgreSQL Database (Vercel Postgres, Neon, Supabase, Railway, etc.)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://postgres:password@ep-sample-pooler.us-east-1.postgres.vercel-storage.com/radar_jang?sslmode=require

# Direct connection string (useful for migrations if connection pooler is used)
DIRECT_URL=postgresql://postgres:password@ep-sample.us-east-1.postgres.vercel-storage.com/radar_jang?sslmode=require

# 2. Admin Security & Auth
ADMIN_PASSWORD=radar-admin-secret
JWT_SECRET=super-secret-jwt-key-min-32-chars-change-in-production

# 3. Media & Uploads (Optional: Cloudinary for cloud images)
# If left empty, files can be stored in /public/uploads or as direct URLs
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 4. LLM API Keys (xAI Grok, Groq, Google Gemini, OpenAI)
XAI_API_KEY=
GROK_MODEL=grok-4.3-latest
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# 5. Telegram Bot & Background Service (Optional)
BOT_TOKEN=
SOURCE_CHANNEL=@databaseradarj
ADMIN_IDS=
EMBEDDING_MODEL=BAAI/bge-m3
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=10
SIMILARITY_THRESHOLD=0.65
ANALYSIS_INTERVAL_HOURS=2
